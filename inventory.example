# Copy to `inventory` (git-ignored); `just init` does it. No host here carries an address: the
# addresses are variables in group_vars/all/local.yml, which group_vars/<group>/connection.yml reads.

# Configured through its API from this machine (ansible_connection: local). Keep this host even
# without a NAS: whether one exists is decided by the NAS addresses in group_vars/all/local.yml,
# and the NAS play ends by itself when there are none.
[nas]
truenas

# The LAN's router, configured through its API from this machine (ansible_connection: local). Keep it without
# one too: whether there is a router to configure is decided by opnsense_address in group_vars/all/local.yml.
[router]
opnsense

# Configured over root SSH.
[proxmox]
homeserver

# The Kubernetes cluster, built from this machine with talosctl and kubectl (ansible_connection: local). Keep it
# without a cluster too: whether one exists is decided by the node addresses in group_vars/all/local.yml.
[kubernetes]
homeserver-k8s
