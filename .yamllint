---
extends: default

# The defaults, plus the committed examples of the git-ignored local.yml and vault.
yaml-files:
  - "*.yaml"
  - "*.yml"
  - .yamllint
  - "*.yml.example"

ignore: |
  .venv/
  .ansible/
  .cache/
  .claude/
  docs/
  k8s/
  group_vars/all/local.vault.yml
  group_vars/all/vault.yml

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: true
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
