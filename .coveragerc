# Coverage of the roles' Python under `make test`: a report, not a gate. It sees only the in-process
# tests; the idempotence tests run the modules inside ansible-playbook, out of its reach. Each directory
# is named, since coverage lists files that no test imports only from the directories given here.
[run]
source =
    roles/truenas/library
    roles/truenas/module_utils
branch = true

[report]
show_missing = true
