---
# The vault: Ansible's secrets, in group_vars/all/local.vault.yml (git-ignored),
# encrypted with the password in .vault_pass. just vault new writes it from
# local.vault.yml.example, every key empty, and just init or just vault fills
# them in. Neither file is ever committed: keep a copy of both in your password
# manager (README.md, Setups and the vault).
#
# A setup needs only the keys it uses. An empty key counts as unset, so leave
# the others empty.

# ------------------------------------------------------------------ TrueNAS ---
# With a NAS: the TrueNAS API key, for a local user in builtin_administrators,
# made in its web UI over HTTPS (scripts/runbooks/REBUILD.md, section 2).
# TrueNAS shows it once.
vault_truenas_api_key: ""

# With alert mail (truenas_mail_server in local.yml): the mail server's
# password, for the truenas_mail_user login. Changing it here is enough: the
# next run sends it to the NAS.
vault_truenas_mail_password: ""

# ------------------------------------------------------------------- Router ---
# With the router (opnsense_address in local.yml): the API key pair of its user
# for this project, made under System > Access > Users
# (scripts/runbooks/opnsense.md). OPNsense shows the pair once, in the file it
# downloads: its key= line here,
vault_opnsense_api_key: ""
# and its secret= line here.
vault_opnsense_api_secret: ""

# With the router: the password its configuration backups are encrypted with.
# Make one up, long and random (openssl rand -hex 32): OPNsense has no setting
# for it. Keep it in your password manager too, where it must stay: nothing
# else opens the backups, and the router's own Restore page asks for it.
vault_opnsense_backup_password: ""

# With the router, needed only for a restore: root's web UI password, which a
# restore logs in with (the API cannot upload a configuration). Give a fresh
# install the same one in its installer, and it serves there too.
vault_opnsense_root_password: ""

# ------------------------------------------------------------------ Proxmox ---
# With remote access (tailscale_enabled or tailscale_advertise_routes in
# local.yml): a one-off, pre-approved auth key, tagged tag:homeserver, spent at
# the host's first login (scripts/runbooks/tailscale.md, section 4). A spent key
# does nothing, so leave it here.
vault_tailscale_auth_key: ""

# ----------------------------------------------------------- Home Assistant ---
# With Home Assistant (haos_mac in local.yml): the password of its owner
# account, which just deploy homeassistant creates before anyone else on the
# network can; 12 characters at least, from your password manager.
vault_haos_owner_password: ""
