---
# Copy to group_vars/all/local.yml (git-ignored) and fill in your environment.
#
#   cp group_vars/all/local.yml.example group_vars/all/local.yml     (or: make init)
#
# This repo is public, so no address is ever written in a task, a role default
# or any other tracked file. Roles read them from the variables below, and the
# real values exist only in local.yml. The values here are documentation
# placeholders (RFC 5737 addresses, made-up serials), not real hosts.

# ------------------------------------------------------------------ TrueNAS ---
# No NAS? Delete this whole section, or leave every value empty. With no NAS address the NAS play
# ends by itself, and Proxmox keeps its VM disks on the storage its installer created (local-lvm, or
# proxmox_local_vm_storage below). Everything a Proxmox-only setup needs is in the Proxmox section.
# A section that keeps other values but no address is refused: that is what a misspelt address looks like.
#
# The address the NAS should end up on, in CIDR form, and the gateway and name
# servers it should use once DHCP is off.
truenas_static_address: 192.0.2.10/24
truenas_gateway: 192.0.2.1
truenas_nameservers:
  - 192.0.2.1
# SHA-256 fingerprint of the NAS's web certificate. With it set, the API key is
# sent only to a server presenting that certificate, even at the bootstrap
# address after DHCP has handed it to another device. Read it with:
#   openssl s_client -connect <nas>:443 </dev/null | openssl x509 -noout -fingerprint -sha256
# Update it whenever the certificate is replaced. Empty disables the check.
truenas_api_cert_sha256: "AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99"
# The address a freshly installed NAS answers on before the role has given it
# the static one (whatever DHCP handed out). Tried after the static address.
truenas_bootstrap_address: 192.0.2.50
# Disk serials per pool. Only read when a pool has to be created on blank
# disks (truenas_pool_allow_create); importing an existing pool ignores them.
truenas_pool_disks:
  persistent:
    - SERIAL-0001
    - SERIAL-0002
    - SERIAL-0003
    - SERIAL-0004
    - SERIAL-0005
  ephemeral:
    - SERIAL-0006
# The pools are called persistent (redundant: data that cannot be re-created)
# and ephemeral (no redundancy: data that can). Name yours here only if they
# are called something else; the keys of truenas_pool_disks follow suit.
# truenas_pool_persistent: tank
# truenas_pool_ephemeral: scratch
# Alert e-mail (a degraded pool, a pool filling up): the mail server the NAS
# sends through, and where alerts go. Its password goes in the vault, as
# vault_truenas_mail_password (make vault-edit). Without these, no mail is set.
# With a server, a sender address is required: truenas_mail_from, or
# truenas_mail_user when that is an address. An alert address needs a server.
# truenas_mail_server: smtp.example.org
# truenas_mail_port: 587
# truenas_mail_security: TLS
# truenas_mail_user: nas@example.org
# truenas_mail_from: nas@example.org
# truenas_alert_email: admin@example.org

# ------------------------------------------------------------------ Proxmox ---
# The Proxmox host: reached over root SSH, and the only host allowed to mount
# the NAS's VM shares.
proxmox_address: 192.0.2.20

# The storage the Proxmox installer created, which holds the VM disks that
# stay on the host: every VM's without a NAS, and the cluster's system disks
# with one too. local-lvm unless this names another; a ZFS install calls it
# local-zfs, and a BTRFS install local-btrfs, and then needs this line in
# either setup.
# proxmox_local_vm_storage: local-zfs

# The nightly backup of the VMs. With a NAS it goes to the NAS. Without one,
# name a Proxmox storage that holds backups: a USB disk added as a directory
# storage (set it up as a checked mount point: pvesm set <id> --is_mountpoint
# yes --create-base-path 0), or a Proxmox Backup Server. Unset, nothing is
# backed up, and every run says so.
# vm_backup_storage: usb-backup
# Other VMs to back up with the cluster's, such as one made by hand. Never
# Home Assistant's: with haos_mac below, the backup covers it by itself.
# vm_backup_extra_vmids: [320]

# Remote access through Tailscale (scripts/runbooks/tailscale.md): the Proxmox
# host becomes the LAN's subnet router, so every VM, the NAS and the router
# answer from your tailnet at their LAN addresses. List the LAN's IPv4 prefix
# in CIDR form. Write the tailnet's policy first, and put a one-off auth key in
# the vault as vault_tailscale_auth_key. Unset, Tailscale is not installed.
# tailscale_advertise_routes: [192.0.2.0/24]

# --------------------------------------------------------------- Kubernetes ---
# No cluster? Delete this whole section. With no node addresses the Kubernetes
# play ends by itself, the Proxmox play creates no VM and the NAS play exports
# nothing to a cluster. A section that keeps other values but no address is
# refused: that is what a misspelt address looks like.
#
# Each node's address, reserved in the router's DHCP outside its dynamic range.
# Both setups have the same two nodes: a control plane, and a worker that runs
# every app.
kubernetes_node_addresses:
  homeserver-cp-1: 192.0.2.30
  homeserver-worker-1: 192.0.2.31
# Each node's MAC, chosen by you and reserved in DHCP for its address before the
# first run: locally administered, in lower case, its second hex digit 2, 6, a
# or e. Replace each <mac>; a placeholder left here is refused.
kubernetes_node_macs:
  homeserver-cp-1: "<mac>"
  homeserver-worker-1: "<mac>"
# MetalLB's addresses, outside the DHCP range: a range, and the two the
# ingress (Traefik) and the cameras' streams (Frigate) keep.
kubernetes_lb_range: 192.0.2.40-192.0.2.49
kubernetes_lb_traefik_ip: 192.0.2.40
kubernetes_lb_frigate_ip: 192.0.2.41
# The repository the cluster syncs, which Flux applies with cluster-admin
# rights. There is no default: name your own.
flux_sync_url: https://github.com/<you>/homeserver.git
# The branch, when not main, as a full reference (refs/heads/<branch>): a
# validation branch for a test cluster, say. Only main is protected (a pull
# request and CI required), and whoever can push to the synced branch owns the
# cluster, so another branch is refused unless flux_sync_ref_unprotected says
# you know; keep Flux's source suspended while you are not testing
# (scripts/runbooks/talos.md).
# flux_sync_ref: refs/heads/main
# flux_sync_ref_unprotected: true
# Where this machine keeps the cluster's talosconfig, kubeconfig, record of the
# bootstrap and etcd snapshots, outside the repository. One per cluster: a test
# host's copy names its own (scripts/runbooks/talos.md).
# kubernetes_talos_config_dir: ~/.talos/homeserver
# The age key Flux decrypts the cluster's Secrets with, a file of its own, mode
# 0600 (k8s/README-secrets.md). A test host's copy names its own key, never the
# home cluster's (scripts/runbooks/talos.md).
# sops_age_key_file: ~/.config/sops/age/homeserver.agekey
# The apps answer at <app>.<domain>; point a wildcard DNS record for
# *.<domain> at kubernetes_lb_traefik_ip.
# kubernetes_domain: homeserver.internal
# The clients Traefik serves: one IPv4 range, your LAN's or, with VLANs, your
# own devices'. Leave it unset on a new cluster: Traefik then answers everyone
# with 403 while you set each app up through kubectl port-forward, since several
# make their first visitor the admin (scripts/runbooks/first-run.md). Set it
# once they are all set up, and run make kubernetes.
# kubernetes_ingress_allowed_range: 192.0.2.0/24
# Extra names for the Kubernetes API's certificate, set before the first build,
# so the API can later be reached by name.
# kubernetes_api_sans: [k8s-api.home.arpa]
# The nodes' sizes fit the home host. Without a NAS, size the worker to what
# the host can spare (required), and on a small host the control plane too
# (2 GiB of memory and a 10 GiB system disk at least; it takes no data disk):
# kubernetes_node_sizes:
#   homeserver-worker-1: {cores: 6, memory_mib: 24576, system_disk_gib: 64, data_disk_gib: 150, media_disk_gib: 1000}
#   homeserver-cp-1: {cores: 2, memory_mib: 4096, system_disk_gib: 32}
# Without a NAS and with no room for a media disk: keep the media and camera
# recordings on the data volume, where they are backed up and share its space.
# Nothing caps them there: a growing library, SABnzbd's downloads or Frigate's
# recordings can fill the volume under every app's database and Prometheus, so
# prefer a media disk when the host has room for one.
# kubernetes_media_on_data_volume: true
# On a BTRFS install, which disables local, the Talos ISO goes on local-btrfs.
# kubernetes_iso_storage: local-btrfs
# The host's iGPU for the worker: the id of a Proxmox PCI resource mapping you
# made for it (scripts/runbooks/gpu.md). Unset, every app runs on the CPU.
# kubernetes_gpu_mapping: igpu
# Home Assistant OS's address, for Homepage's tile: its own local name and
# port, never under the cluster's domain (scripts/runbooks/haos.md).
# haos_url: http://homeassistant.home.arpa/

# ----------------------------------------------------------- Home Assistant ---
# No Home Assistant? Delete this section. With it, make homeassistant creates
# Home Assistant OS as a VM of its own on the Proxmox host (VMID 310), with or
# without a cluster or a NAS, gives it its owner account, and the nightly backup
# covers it (scripts/runbooks/haos.md). The owner's password is the vault's
# vault_haos_owner_password (make vault-edit).
#
# Its MAC, chosen by you and reserved in the router's DHCP before the first run,
# with the hostname homeassistant: locally administered, in lower case, its
# second hex digit 2, 6, a or e, and not a cluster node's. Replace <mac>; a
# placeholder left here is refused.
haos_mac: "<mac>"
# USB devices passed through, such as a Zigbee or Z-Wave stick: by the
# vendor:product id lsusb on the Proxmox host shows, which follows the stick to
# any port, or by a Proxmox USB resource mapping.
# haos_usb: [{host: "10c4:ea60"}]
# Its size, when not 2 cores, 4 GiB of memory and a 32 GiB disk (the least).
# haos_size: {cores: 2, memory_mib: 4096, disk_gib: 64}
# The owner account's name and username, when not Owner and owner.
# haos_owner_name: Owner
# haos_owner_username: owner
# Another VMID, when 310 is taken.
# haos_vmid: 310
# On a BTRFS install, which disables local, the OVA goes on local-btrfs.
# haos_import_storage: local-btrfs
