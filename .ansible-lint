---
# ansible-lint configuration. "production" is the strictest built-in profile, and strict makes its
# warnings fail the run too.
profile: production
strict: true

exclude_paths:
  - .venv/
  - .ansible/
  - .cache/
  - .claude/
  - docs/
  # Kubernetes manifests, not Ansible. kubeconform validates them (see CLAUDE.md).
  - k8s/

# Roles here are used from this repo, never published to Galaxy.
offline: true

kinds:
  - yaml: "**/*.yml.example"

enable_list:
  # A task that calls a TrueNAS module carries "# noqa: args". The rule imports a module to check its options, and
  # cannot import a role's module_utils (only a collection's: ansible-lint#3891), so it stopped at the first such task,
  # warning, and left the rest of the file unchecked. tests/policy/test_roles.py checks those tasks' options instead,
  # and that each carries the comment.
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - name[prefix]
  - yaml

skip_list:
  - galaxy[no-changelog]
  - galaxy[version-incorrect]
